# NexaLogin Root Environment Configuration Example
PORT=3001
JWT_SECRET=tarcin-jwt-secret-replace-in-production

# Set to true to activate MongoDB Atlas connection
ENABLE_MONGODB=false
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexalogin?retryWrites=true&w=majority

# Observe credentials
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET
